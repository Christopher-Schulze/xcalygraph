(defpackage :store (:use :cl :util) (:export #:open-store))
(in-package :store)
(defclass repo (base) ((rows :initform nil)))
(defgeneric find-row (repo id))
(defmethod find-row ((r repo) id) (nth id (slot-value r 'rows)))
(defun open-store (path)
  (let ((url (uiop:getenv "STORE_URL")))
    (helper path)
    (util:check url)
    (make-instance 'repo)))
(defmacro with-store ((var) &body body) `(let ((,var (open-store "x"))) ,@body))

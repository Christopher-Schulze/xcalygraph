sym 2-2 const util parent=- owner= priv flags=0 sig="const util = require(\"./util\")" doc=""
sym 4-6 fn format parent=- owner= priv flags=0 sig="function format(text)" doc=""
import 2 "./util" names= alias=util reexport=false
ref 5 Call join qualifier=- scope=format args=1
ref 5 Value text qualifier=- scope=format
ref 5 Call trim qualifier=util scope=format args=1
ref 8 Value format qualifier=- scope=-
bind 2 "util": require() inferred scope=util

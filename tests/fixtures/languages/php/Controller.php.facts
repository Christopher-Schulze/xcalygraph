import 5 "App\\Store" names=Row alias=- reexport=false
import 6 "App\\Store" names=Repository alias=Repo reexport=false
ref 10 Type Repo qualifier=- scope=__construct
ref 14 Value $id qualifier=- scope=show
ref 14 Call find qualifier=$this->repository scope=show args=1
ref 15 Value $row qualifier=- scope=show
